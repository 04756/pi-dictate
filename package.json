{
  "name": "pi-dictate",
  "version": "0.1.0",
  "description": "Local-first macOS voice dictation for Pi with Whisper transcription and current-model rewrite.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "voice",
    "dictation",
    "speech-to-text",
    "stt",
    "whisper",
    "macos"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "smoke": "node --import tsx -e \"import ext from './src/index.ts'; if (typeof ext !== 'function') throw new Error('Extension default export is not a function'); console.log('pi-dictate')\""
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.75.5",
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@earendil-works/pi-tui": "^0.75.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
